# Port & Host
PORT=3000
NODE_ENV=development

# Authentication Secrets
JWT_ACCESS_SECRET="pulseboard_jwt_access_secret_super_secure_key_2026"
JWT_REFRESH_SECRET="pulseboard_jwt_refresh_secret_super_secure_key_2026"

# Database connection string (optional - defaults to embedded PostgreSQL via PGlite if not provided)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulseboard"

# Overdue task background scheduler cron expression (defaults to every minute: * * * * *)
OVERDUE_JOB_CRON="* * * * *"

